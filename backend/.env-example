# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://your-frontend-app.vercel.app

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/database-name

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_change_this_in_production

#npm run seed:superadmin
SUPERADMIN_EMAIL=superadmin@gmail.com
SUPERADMIN_INITIAL_PASSWORD=Superadmin123

# Cloudinary Media Storage (Required for Render ephemeral disk persistence)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini Free AI (Optional - get free key at aistudio.google.com)
# When set, enables generative AI Style Consultations in chatbot; otherwise uses smart built-in rules
GEMINI_API_KEY=your_gemini_api_key_here

#Local development otp receiver with backend - "npm run dev" 
NODE_ENV=development
DEBUG_LOG_OTP=true

# SendGrid Email (Primary email provider — uses HTTPS API, so it works even
# on hosts like Render's free tier that block outbound SMTP ports)
# Get an API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
# Must exactly match a sender you have verified in SendGrid's dashboard
# (Settings > Sender Authentication), otherwise SendGrid will reject the send.
SENDGRID_FROM_EMAIL=your_verified_sender@example.com

# Resend Email (Fallback provider, used only if SendGrid is not configured
# or fails to deliver). Get a key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Gmail SMTP (Final fallback provider — may be blocked on some hosts'
# free tiers). Use a Gmail App Password, not your regular account password.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password